# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Test coverage
.coverage
.pytest_cache/
htmlcov/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Type checking
.mypy_cache/

# OS files
.DS_Store
Thumbs.db

# pyenv
.python-version

# PR descriptions (temporary reference documents)
.github/pr_descriptions/*
!.github/pr_descriptions/pull_request_template.md

# Demo tapes and generated outputs (VHS); README, tapes, demo asset tracked; output/ for GIFs/MP4s
docs/demos/*
!docs/demos/README.md
!docs/demos/tapes/
!docs/demos/sample.mp3

# Article demos (per folder under content/articles/<name>/): ignore loose/generated files;
# track README/scenario .md, tapes/, shell/Python helpers; whitelisted demo audio only under samples/ (below).
content/articles/*/*
!content/articles/*/*.md
!content/articles/*/*.sh
!content/articles/*/*.py
!content/articles/*/tapes/
!content/articles/*/samples/
content/articles/*/samples/*
!content/articles/*/samples/README.md
!content/articles/*/samples/sample.mp3
!content/articles/*/samples/sample.flac
!content/articles/*/samples/sample.wav
content/articles/*/output/

# Node.js (for git-worktree-scripts dev dependency)
node_modules/
package-lock.json

DESIGN_PATTERNS.md
INTERVIEW_PATTERNS.md
# graphify
graphify-out/
